        "summary": "Get Job",
        "tags": ["courses"]
      }
    },
    "/v1/jobs/{job_id}/cancel": {
      "post": {
        "operationId": "jobs.cancel",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": { "title": "Job Id", "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Job" } } },
