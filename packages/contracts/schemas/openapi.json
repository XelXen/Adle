{
  "components": {
    "schemas": {
      "Course": {
        "properties": {
          "created_at": { "format": "date-time", "title": "Created At", "type": "string" },
          "description": { "title": "Description", "type": "string" },
          "id": { "title": "Id", "type": "string" },
          "last_opened_at": {
            "anyOf": [{ "format": "date-time", "type": "string" }, { "type": "null" }],
            "title": "Last Opened At"
          },
          "origin": {
            "enum": ["sample", "topic", "materials"],
            "title": "Origin",
            "type": "string"
          },
          "source_count": { "title": "Source Count", "type": "integer" },
          "title": { "title": "Title", "type": "string" },
          "topic": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Topic" },
          "updated_at": { "format": "date-time", "title": "Updated At", "type": "string" }
        },
        "required": [
          "id",
          "title",
          "description",
          "origin",
          "topic",
          "source_count",
          "created_at",
          "updated_at",
          "last_opened_at"
        ],
        "title": "Course",
        "type": "object"
      },
      "CourseCreate": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "default": "",
            "maxLength": 4000,
            "title": "Description",
            "type": "string"
          },
          "origin": { "enum": ["topic", "materials"], "title": "Origin", "type": "string" },
          "title": { "maxLength": 200, "minLength": 1, "title": "Title", "type": "string" },
          "topic": {
            "anyOf": [{ "maxLength": 4000, "type": "string" }, { "type": "null" }],
            "title": "Topic"
          }
        },
        "required": ["title", "origin"],
        "title": "CourseCreate",
        "type": "object"
      },
      "CourseList": {
        "properties": {
          "courses": {
            "items": { "$ref": "#/components/schemas/Course" },
            "title": "Courses",
            "type": "array"
          }
        },
        "required": ["courses"],
        "title": "CourseList",
        "type": "object"
      },
      "CourseUpdate": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "anyOf": [{ "maxLength": 4000, "type": "string" }, { "type": "null" }],
            "title": "Description"
          },
          "title": {
            "anyOf": [{ "maxLength": 200, "minLength": 1, "type": "string" }, { "type": "null" }],
            "title": "Title"
          }
        },
        "title": "CourseUpdate",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": { "title": "Code", "type": "string" },
          "detail": { "anyOf": [{}, { "type": "null" }], "title": "Detail" },
          "message": { "title": "Message", "type": "string" },
          "retry_after_seconds": {
            "anyOf": [{ "type": "number" }, { "type": "null" }],
            "title": "Retry After Seconds"
          }
        },
        "required": ["code", "message"],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": { "error": { "$ref": "#/components/schemas/ErrorBody" } },
        "required": ["error"],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Health": {
        "properties": {
          "api_version": { "title": "Api Version", "type": "string" },
          "status": { "title": "Status", "type": "string" },
          "version": { "title": "Version", "type": "string" }
        },
        "required": ["status", "version", "api_version"],
        "title": "Health",
        "type": "object"
      },
      "HighlightSegment": {
        "properties": {
          "highlighted": { "title": "Highlighted", "type": "boolean" },
          "text": { "title": "Text", "type": "string" }
        },
        "required": ["text", "highlighted"],
        "title": "HighlightSegment",
        "type": "object"
      },
      "ImportRequest": {
        "additionalProperties": false,
        "description": "Absolute paths chosen by the learner. Only the desktop shell may send this.",
        "properties": {
          "paths": {
            "items": { "maxLength": 4096, "minLength": 1, "type": "string" },
            "maxItems": 50,
            "minItems": 1,
            "title": "Paths",
            "type": "array"
          }
        },
        "required": ["paths"],
        "title": "ImportRequest",
        "type": "object"
      },
      "Job": {
        "properties": {
          "course_id": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Course Id"
          },
          "error_code": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Error Code"
          },
          "error_message": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Error Message"
          },
          "id": { "title": "Id", "type": "string" },
          "kind": { "title": "Kind", "type": "string" },
          "progress_done": { "title": "Progress Done", "type": "integer" },
          "progress_message": { "title": "Progress Message", "type": "string" },
          "progress_total": { "title": "Progress Total", "type": "integer" },
          "result": { "anyOf": [{}, { "type": "null" }], "title": "Result" },
          "status": {
            "enum": ["queued", "running", "succeeded", "failed", "cancelled"],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "course_id",
          "status",
          "progress_done",
          "progress_total",
          "progress_message",
          "result",
          "error_code",
          "error_message"
        ],
        "title": "Job",
        "type": "object"
      },
      "ProviderCredential": {
        "additionalProperties": false,
        "properties": {
          "api_key": {
            "maxLength": 512,
            "minLength": 8,
            "pattern": "^[\\x21-\\x7e]+$",
            "title": "Api Key",
            "type": "string"
          }
        },
        "required": ["api_key"],
        "title": "ProviderCredential",
        "type": "object"
      },
      "ProviderStatus": {
        "properties": {
          "base_url": { "title": "Base Url", "type": "string" },
          "display_name": { "title": "Display Name", "type": "string" },
          "key_configured": { "title": "Key Configured", "type": "boolean" },
          "model": { "title": "Model", "type": "string" },
          "provider_id": { "title": "Provider Id", "type": "string" }
        },
        "required": ["provider_id", "display_name", "base_url", "model", "key_configured"],
        "title": "ProviderStatus",
        "type": "object"
      },
      "SearchHit": {
        "properties": {
          "chunk_id": { "title": "Chunk Id", "type": "integer" },
          "excerpt": {
            "items": { "$ref": "#/components/schemas/HighlightSegment" },
            "title": "Excerpt",
            "type": "array"
          },
          "page_number": {
            "anyOf": [{ "type": "integer" }, { "type": "null" }],
            "title": "Page Number"
          },
          "section_title": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Section Title"
          },
          "source_id": { "title": "Source Id", "type": "string" },
          "source_name": { "title": "Source Name", "type": "string" }
        },
        "required": [
          "chunk_id",
          "source_id",
          "source_name",
          "section_title",
          "page_number",
          "excerpt"
        ],
        "title": "SearchHit",
        "type": "object"
      },
      "SearchResults": {
        "properties": {
          "hits": {
            "items": { "$ref": "#/components/schemas/SearchHit" },
            "title": "Hits",
            "type": "array"
          },
          "query": { "title": "Query", "type": "string" }
        },
        "required": ["query", "hits"],
        "title": "SearchResults",
        "type": "object"
      },
      "Source": {
        "properties": {
          "char_count": { "title": "Char Count", "type": "integer" },
          "chunk_count": { "title": "Chunk Count", "type": "integer" },
          "course_id": { "title": "Course Id", "type": "string" },
          "created_at": { "format": "date-time", "title": "Created At", "type": "string" },
          "display_name": { "title": "Display Name", "type": "string" },
          "id": { "title": "Id", "type": "string" },
          "kind": {
            "enum": ["pdf", "docx", "markdown", "text", "authored"],
            "title": "Kind",
            "type": "string"
          },
          "page_count": { "title": "Page Count", "type": "integer" },
          "section_count": { "title": "Section Count", "type": "integer" },
          "size_bytes": { "title": "Size Bytes", "type": "integer" },
          "status": {
            "enum": ["extracted", "needs_attention"],
            "title": "Status",
            "type": "string"
          },
          "warnings": { "items": { "type": "string" }, "title": "Warnings", "type": "array" }
        },
        "required": [
          "id",
          "course_id",
          "display_name",
          "kind",
          "status",
          "warnings",
          "size_bytes",
          "char_count",
          "section_count",
          "chunk_count",
          "page_count",
          "created_at"
        ],
        "title": "Source",
        "type": "object"
      },
      "SourceDetail": {
        "properties": {
          "sections": {
            "items": { "$ref": "#/components/schemas/SourceSection" },
            "title": "Sections",
            "type": "array"
          },
          "source": { "$ref": "#/components/schemas/Source" }
        },
        "required": ["source", "sections"],
        "title": "SourceDetail",
        "type": "object"
      },
      "SourceList": {
        "properties": {
          "sources": {
            "items": { "$ref": "#/components/schemas/Source" },
            "title": "Sources",
            "type": "array"
          }
        },
        "required": ["sources"],
        "title": "SourceList",
        "type": "object"
      },
      "SourceSection": {
        "properties": {
          "char_count": { "title": "Char Count", "type": "integer" },
          "confidence": { "title": "Confidence", "type": "number" },
          "id": { "title": "Id", "type": "string" },
          "kind": { "enum": ["document", "page", "heading"], "title": "Kind", "type": "string" },
          "level": { "anyOf": [{ "type": "integer" }, { "type": "null" }], "title": "Level" },
          "ordinal": { "title": "Ordinal", "type": "integer" },
          "page_number": {
            "anyOf": [{ "type": "integer" }, { "type": "null" }],
            "title": "Page Number"
          },
          "title": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Title" }
        },
        "required": [
          "id",
          "ordinal",
          "kind",
          "title",
          "page_number",
          "level",
          "char_count",
          "confidence"
        ],
        "title": "SourceSection",
        "type": "object"
      }
    }
  },
  "info": { "title": "Adle core", "version": "0.1.0" },
  "openapi": "3.1.0",
  "paths": {
    "/v1/courses": {
      "get": {
        "operationId": "courses.list",
        "responses": {
          "200": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CourseList" } }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "List Courses",
        "tags": ["courses"]
      },
      "post": {
        "operationId": "courses.create",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CourseCreate" } }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Course" } }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Create Course",
        "tags": ["courses"]
      }
    },
    "/v1/courses/{course_id}": {
      "delete": {
        "operationId": "courses.delete",
        "parameters": [
          {
            "in": "path",
            "name": "course_id",
            "required": true,
            "schema": { "title": "Course Id", "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Successful Response" },
          "401": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Delete Course",
        "tags": ["courses"]
      },
      "get": {
        "operationId": "courses.get",
        "parameters": [
          {
            "in": "path",
            "name": "course_id",
            "required": true,
            "schema": { "title": "Course Id", "type": "string" }
          },
          {
            "description": "Record that the learner opened the course.",
            "in": "query",
            "name": "opened",
            "required": false,
            "schema": {
              "default": false,
              "description": "Record that the learner opened the course.",
              "title": "Opened",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Course" } }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Get Course",
        "tags": ["courses"]
      },
      "patch": {
        "operationId": "courses.update",
        "parameters": [
          {
            "in": "path",
            "name": "course_id",
            "required": true,
            "schema": { "title": "Course Id", "type": "string" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CourseUpdate" } }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Course" } }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Update Course",
        "tags": ["courses"]
      }
    },
    "/v1/courses/{course_id}/search": {
      "get": {
        "operationId": "sources.search",
        "parameters": [
          {
            "in": "path",
            "name": "course_id",
            "required": true,
            "schema": { "title": "Course Id", "type": "string" }
          },
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": { "maxLength": 200, "minLength": 1, "title": "Q", "type": "string" }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 8,
              "maximum": 20,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SearchResults" } }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Search Sources",
        "tags": ["courses"]
      }
    },
    "/v1/courses/{course_id}/sources": {
      "get": {
        "operationId": "sources.list",
        "parameters": [
          {
            "in": "path",
            "name": "course_id",
            "required": true,
            "schema": { "title": "Course Id", "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SourceList" } }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "List Sources",
        "tags": ["courses"]
      }
    },
    "/v1/courses/{course_id}/sources/import": {
      "post": {
        "operationId": "sources.import_paths",
        "parameters": [
          {
            "in": "path",
            "name": "course_id",
            "required": true,
            "schema": { "title": "Course Id", "type": "string" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ImportRequest" } }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Job" } } },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Import Sources",
        "tags": ["courses"],
        "x-adle-internal": true
      }
    },
    "/v1/health": {
      "get": {
        "description": "Liveness check used by the desktop shell after the ready handshake.",
        "operationId": "system.health",
        "responses": {
          "200": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Health" } }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Health",
        "tags": ["system"]
      }
    },
    "/v1/jobs/{job_id}": {
      "get": {
        "operationId": "jobs.get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
